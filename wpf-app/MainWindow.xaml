<Window x:Class="VRCVideoTools.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:VRCVideoTools.App"
        mc:Ignorable="d"
        Title="VRC-VideoTools"
        Height="860" Width="1220"
        MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Foreground="#F4F3EF"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, sans-serif"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <!-- Slim Custom ScrollBar (Zero Win11 Thick Bars) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRect" Background="#343339" CornerRadius="3" Margin="1,2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="#525059" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Rounded Omnibar & Stream TextBox (Zero Win11 Bottom Underline) -->
        <Style x:Key="StudioTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#111114" />
            <Setter Property="Foreground" Value="#F4F3EF" />
            <Setter Property="CaretBrush" Value="#F4F3EF" />
            <Setter Property="SelectionBrush" Value="#484640" />
            <Setter Property="BorderBrush" Value="#2C2B30" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#7E7C76"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#3E3D43" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#636058" />
                                <Setter TargetName="BoxBorder" Property="Background" Value="#141417" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BoxBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Warm Ivory Tactile Squircle Button -->
        <Style x:Key="StudioPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F3F2EE" />
            <Setter Property="Foreground" Value="#141416" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#DFDDD6" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Soft Graphite Pill Button -->
        <Style x:Key="StudioSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#222227" />
            <Setter Property="Foreground" Value="#F0EFEA" />
            <Setter Property="BorderBrush" Value="#323138" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2B2B32" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#45444D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1B1B20" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet Ghost Pill Button -->
        <Style x:Key="StudioGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A5A29B" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#202025" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2F2E35" />
                                <Setter Property="Foreground" Value="#F4F3EF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Floating Capsule Segmented Control -->
        <Style x:Key="StudioSegmentRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9B9891" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegPill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="13,5"
                                Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegPill" Property="Background" Value="#1E1E23" />
                                <Setter Property="Foreground" Value="#E6E4DE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegPill" Property="Background" Value="#2A2A31" />
                                <Setter Property="Foreground" Value="#F4F3EF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Rounded ComboBox (Eliminates Win11 Stiff Dropdown Chrome) -->
        <Style x:Key="StudioComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6E4DE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#292930" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#31313A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1B1B1F" />
            <Setter Property="BorderBrush" Value="#2D2C33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F4F3EF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0,12,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource StudioComboBoxItemStyle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#1B1B1F"
                                                BorderBrush="#2D2C33"
                                                BorderThickness="1"
                                                CornerRadius="11">
                                            <Grid Margin="14,0,12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown20" FontSize="14" Foreground="#A5A29B" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#202025" />
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#403F47" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5C5A52" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="14,0,36,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ToggleBtn}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   VerticalOffset="6">
                                <Border Background="#1D1D22"
                                        BorderBrush="#33323B"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-Style Circular Window Control Button -->
        <Style x:Key="TrafficLightBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot"
                                Width="14" Height="14"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Tag}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#1A1816"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"
                                       Opacity="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow Shell (Margin="16" when Normal, "0" when Maximized) -->
    <Grid x:Name="RootMarginGrid" Margin="16">
        <Border x:Name="WindowShellBorder"
                CornerRadius="18"
                BorderBrush="#2C2B29"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#19191D" Offset="0" />
                    <GradientStop Color="#121215" Offset="0.35" />
                    <GradientStop Color="#101012" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Custom Draggable Header Bar (Zero Win11 TitleBar Chrome) -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown" Margin="20,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Icon + Brand + Subtle Engine Pill -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="#222227" BorderBrush="#323138" BorderThickness="1" ClipToBounds="True" Margin="0,0,10,0">
                            <Image Source="pack://application:,,,/Assets/app_logo.png" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="VRC·VideoTools" FontSize="14" FontWeight="SemiBold" Foreground="#F4F3EF" VerticalAlignment="Center" />
                        <TextBlock Text="流媒体直链工坊" FontSize="12" Foreground="#8C8982" VerticalAlignment="Center" Margin="10,1,14,0" />

                        <Border Name="CoreStatusBadge" Background="#1D1D22" BorderBrush="#2D2C34" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Name="CoreStatusIcon" Symbol="ArrowSync16" FontSize="12" Foreground="#A5A29B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Name="CoreStatusText" Text="内核启动中…" FontSize="11.5" Foreground="#A5A29B" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Custom Circular Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="MinimizeBtn_Click" Style="{StaticResource TrafficLightBtnStyle}" Background="#D4A54C" Tag="—" ToolTip="最小化" Margin="0,0,9,0" />
                        <Button Click="MaximizeBtn_Click" Style="{StaticResource TrafficLightBtnStyle}" Background="#5BB272" Tag="+" ToolTip="最大化 / 还原" Margin="0,0,9,0" />
                        <Button Click="CloseBtn_Click" Style="{StaticResource TrafficLightBtnStyle}" Background="#D96962" Tag="×" ToolTip="关闭" />
                    </StackPanel>
                </Grid>

                <!-- 2. Floating Omnibar Input Bar -->
                <Border Grid.Row="1" Margin="22,2,22,14" Background="#17171B" BorderBrush="#2A292F" BorderThickness="1" CornerRadius="15" Padding="18,14">
                    <StackPanel>
                        <!-- Header Row: Title + Segmented Platform Pill Switcher -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Link24" FontSize="16" Foreground="#A5A29B" Margin="0,0,8,0" />
                                <TextBlock Text="解析视频链接" FontWeight="SemiBold" FontSize="14" Foreground="#F4F3EF" VerticalAlignment="Center" />
                                <TextBlock Text="支持 B站 / 抖音 / 快手 原生直链与口令穿透" FontSize="12" Foreground="#928F88" VerticalAlignment="Center" Margin="10,1,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#111114" BorderBrush="#242329" BorderThickness="1" CornerRadius="10" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Name="PlatformAutoRadio" Content="自动识别" Style="{StaticResource StudioSegmentRadio}" IsChecked="True" />
                                    <RadioButton Name="PlatformBiliRadio" Content="哔哩哔哩" Style="{StaticResource StudioSegmentRadio}" />
                                    <RadioButton Name="PlatformDouyinRadio" Content="抖音" Style="{StaticResource StudioSegmentRadio}" />
                                    <RadioButton Name="PlatformKuaishouRadio" Content="快手" Style="{StaticResource StudioSegmentRadio}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Input + Primary/Secondary Actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Name="UrlTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource StudioTextBoxStyle}"
                                     Tag="粘贴哔哩哔哩、抖音或快手链接或口令，按 Enter 立即解析…"
                                     KeyDown="UrlTextBox_KeyDown"
                                     Height="44"
                                     Margin="0,0,10,0"
                                     AutomationProperties.Name="视频链接输入框" />

                            <Button Name="PasteAndParseBtn"
                                    Grid.Column="1"
                                    Style="{StaticResource StudioPrimaryButton}"
                                    Click="PasteAndParseBtn_Click"
                                    ToolTip="读取剪贴板链接并解析，完成后自动写回直链"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="16" Foreground="#141416" Margin="0,0,7,0" />
                                    <TextBlock Text="粘贴并解析" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="ParseBtn"
                                    Grid.Column="2"
                                    Style="{StaticResource StudioSecondaryButton}"
                                    Click="ParseBtn_Click"
                                    ToolTip="解析输入框内容 (Enter)"
                                    Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Name="ParseBtnIcon" Symbol="Play24" FontSize="15" Foreground="#F0EFEA" Margin="0,0,6,0" />
                                    <TextBlock Name="ParseBtnLabel" Text="解析" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Name="ClearBtn"
                                    Grid.Column="3"
                                    Style="{StaticResource StudioGhostButton}"
                                    Click="ClearBtn_Click"
                                    ToolTip="清空当前内容">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" Margin="0,0,5,0" />
                                    <TextBlock Text="清空" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Sleek Animated Loading Progress Strip -->
                        <Border Name="LoadingIndicatorBar" Background="#111114" CornerRadius="2" Height="3" Margin="0,12,0,0" ClipToBounds="True" Visibility="Collapsed">
                            <Border x:Name="LoadingShimmerBar" Width="180" Height="3" CornerRadius="2" Background="#E6E4DE" HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ShimmerTransform" X="-180" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. Streamlined Two-Column Studio Workspace -->
                <Grid Grid.Row="2" Margin="22,0,22,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.3*" />
                        <ColumnDefinition Width="3.7*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Main Stage -->
                    <Border Grid.Column="0" Background="#161619" BorderBrush="#25242A" BorderThickness="1" CornerRadius="15" Margin="0,0,14,0" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="ResultCardPanel" Opacity="1.0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="ResultCardTranslate" X="0" Y="0" />
                                </StackPanel.RenderTransform>

                                <!-- Media Showcase Header -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="228" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="11" Background="#111114" BorderBrush="#28272D" BorderThickness="1" Height="128" ClipToBounds="True">
                                        <Grid>
                                            <Image Name="CoverImage" Stretch="UniformToFill" />
                                            <StackPanel Name="CoverPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="VideoClip24" FontSize="24" Foreground="#5A5853" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                <TextBlock Text="暂无视频预览" Foreground="#8A8780" FontSize="12" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <Border Name="DurationBadge" Background="#D8101012" CornerRadius="6" Padding="7,3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" Visibility="Collapsed">
                                                <TextBlock Name="DurationText" Text="00:00" Foreground="#F4F3EF" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                            <Border Name="PlatformBadge" Background="#1D2430" BorderBrush="#2B3648" BorderThickness="1" CornerRadius="99" Padding="10,3" Margin="0,0,8,0">
                                                <TextBlock Name="PlatformBadgeText" Text="待解析" Foreground="#9CBCE3" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Name="QualityBadge" Background="#212126" BorderBrush="#313038" BorderThickness="1" CornerRadius="99" Padding="10,3" Visibility="Collapsed">
                                                <TextBlock Name="QualityBadgeText" Text="--" Foreground="#D4D2CC" FontSize="12" FontWeight="Medium" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Name="TitleTextBlock"
                                                   Text="等待视频链接，点击上方「粘贴并解析」即可秒出直链"
                                                   FontSize="16.5"
                                                   FontWeight="SemiBold"
                                                   LineHeight="23"
                                                   Foreground="#F4F3EF"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="52"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,10" />

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="12" Width="24" Height="24" Background="#232328" BorderBrush="#33323A" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0">
                                                <Image Name="AuthorAvatarImage" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Name="AuthorTextBlock" Text="创作者: --" FontSize="13" Foreground="#A5A29B" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="#232228" Margin="0,0,0,18" />

                                <!-- Custom Rounded Quality ComboBox -->
                                <TextBlock Text="播放画质与节点" FontSize="13" FontWeight="SemiBold" Foreground="#DCDAD3" Margin="0,0,0,8" />
                                <ComboBox Name="QualityComboBox"
                                          Style="{StaticResource StudioComboBoxStyle}"
                                          SelectionChanged="QualityComboBox_SelectionChanged"
                                          Margin="0,0,0,16" />

                                <!-- Direct URL Elevated Row (VRChat Recommended) -->
                                <Border Background="#1B1B20" BorderBrush="#313038" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="官方免防盗链直链" FontSize="13" FontWeight="SemiBold" Foreground="#F4F3EF" VerticalAlignment="Center" />
                                                <Border Background="#1B2A21" BorderBrush="#294032" BorderThickness="1" CornerRadius="99" Padding="8,2" Margin="8,0,0,0">
                                                    <TextBlock Text="VRChat 房间直放 · 推荐" FontSize="11" Foreground="#88C99D" FontWeight="Medium" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Name="DirectUrlTextBox"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource StudioTextBoxStyle}"
                                                     FontFamily="Cascadia Code, Consolas, monospace"
                                                     FontSize="12"
                                                     Height="38"
                                                     Margin="0,0,10,0" />
                                            <Button Name="CopyDirectBtn"
                                                    Grid.Column="1"
                                                    Style="{StaticResource StudioSecondaryButton}"
                                                    Height="38"
                                                    Padding="16,0"
                                                    Click="CopyDirectBtn_Click"
                                                    ToolTip="复制直链并在 VRChat 播放器中粘贴播放">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Name="CopyDirectIcon" Symbol="Copy24" FontSize="15" Foreground="#F0EFEA" Margin="0,0,6,0" />
                                                    <TextBlock Name="CopyDirectLabel" Text="复制直链" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- LAN Relay Fallback Row -->
                                <Border Background="#131316" BorderBrush="#232228" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="局域网中继同步流 (ProTV / USharpVideo 网络隔离备用)" FontSize="12.5" FontWeight="Medium" Foreground="#A5A29B" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Name="VrcUrlTextBox"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource StudioTextBoxStyle}"
                                                     FontFamily="Cascadia Code, Consolas, monospace"
                                                     FontSize="12"
                                                     Height="38"
                                                     Margin="0,0,10,0" />
                                            <Button Name="CopyVrcBtn"
                                                    Grid.Column="1"
                                                    Style="{StaticResource StudioSecondaryButton}"
                                                    Height="38"
                                                    Padding="16,0"
                                                    Click="CopyVrcBtn_Click"
                                                    ToolTip="复制局域网代理流地址">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Name="CopyVrcIcon" Symbol="Share24" FontSize="15" Foreground="#F0EFEA" Margin="0,0,6,0" />
                                                    <TextBlock Name="CopyVrcLabel" Text="复制中继" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Bottom Quick Actions -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="VerifyBrowserBtn"
                                            Style="{StaticResource StudioSecondaryButton}"
                                            Height="38"
                                            Padding="16,0"
                                            Click="VerifyBrowserBtn_Click"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Open24" FontSize="15" Foreground="#F0EFEA" Margin="0,0,6,0" />
                                            <TextBlock Text="浏览器试播…" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Name="CopyTitleBtn"
                                            Style="{StaticResource StudioGhostButton}"
                                            Height="38"
                                            Click="CopyTitleBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="15" Margin="0,0,6,0" />
                                            <TextBlock Name="CopyTitleLabel" Text="复制视频标题" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right Utility Drawer (Clean Hairline Dividers, Zero Nested Boxes!) -->
                    <Border Grid.Column="1" Background="#141417" BorderBrush="#232228" BorderThickness="1" CornerRadius="15" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="局域网物理 IP (同步中继)" FontSize="13" FontWeight="SemiBold" Foreground="#DCDAD3" Margin="0,0,0,8" />
                                <ComboBox Name="LocalIpComboBox"
                                          Style="{StaticResource StudioComboBoxStyle}"
                                          SelectionChanged="LocalIpComboBox_SelectionChanged"
                                          Margin="0,0,0,18" />

                                <TextBlock Text="运行架构参数" FontSize="13" FontWeight="SemiBold" Foreground="#DCDAD3" Margin="0,0,0,10" />
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,7">
                                        <TextBlock Text="流媒体引擎" FontSize="12" Foreground="#8A8780" />
                                        <TextBlock Text="Go 1.26 并发零拷贝" FontSize="12" Foreground="#D4D2CC" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <TextBlock Text="B站白名单节点" FontSize="12" Foreground="#8A8780" />
                                        <TextBlock Text="mirrorcos 中文吧兼容" FontSize="12" Foreground="#D4D2CC" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <TextBlock Text="接口穿透模式" FontSize="12" Foreground="#8A8780" />
                                        <TextBlock Text="Feed + wbi 免 412 直连" FontSize="12" Foreground="#D4D2CC" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="剪贴板交互" FontSize="12" Foreground="#8A8780" />
                                        <TextBlock Text="Win32 异步无锁通道" FontSize="12" Foreground="#D4D2CC" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="#222127" Margin="0,0,0,16" />

                                <TextBlock Text="VRChat 使用提示" FontSize="13" FontWeight="SemiBold" Foreground="#DCDAD3" Margin="0,0,0,10" />
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#232229" CornerRadius="9" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="#D4D2CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="优先复制「官方免防盗链直链」，在房间播放器直接粘贴即可全员同步。" FontSize="12" Foreground="#9B9891" TextWrapping="Wrap" Margin="8,0,0,0" LineHeight="17" />
                                    </Grid>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#232229" CornerRadius="9" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="#D4D2CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="若房间存在网络隔离，可改用「局域网中继流」自动注入合法请求头。" FontSize="12" Foreground="#9B9891" TextWrapping="Wrap" Margin="8,0,0,0" LineHeight="17" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#232229" CornerRadius="9" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="#D4D2CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="自动优选 H.264 与流畅码率节点，避免 AVPro / ProTV 播放卡顿。" FontSize="12" Foreground="#9B9891" TextWrapping="Wrap" Margin="8,0,0,0" LineHeight="17" />
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="#222127" Margin="0,0,0,14" />

                                <TextBlock Text="活动日志" FontSize="13" FontWeight="SemiBold" Foreground="#DCDAD3" Margin="0,0,0,8" />
                                <Border Background="#101012" CornerRadius="10" BorderBrush="#1F1E24" BorderThickness="1" Height="142" Padding="10">
                                    <ScrollViewer Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Name="LogTextBlock" Text="[系统就绪] 等待操作..." FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" Foreground="#94918A" TextWrapping="Wrap" LineHeight="17" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 4. Custom Floating Status Toast Pill (Replaces Win11 InfoBar) -->
                <Border Name="StatusToastBorder"
                        Grid.Row="3"
                        Margin="22,0,22,18"
                        Background="#18181C"
                        BorderBrush="#29282F"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,10">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="StatusToastTranslate" X="0" Y="0" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Name="StatusToastIcon" Symbol="Info24" FontSize="16" Foreground="#9CBCE3" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Name="StatusToastTitle" Text="就绪" FontSize="12.5" FontWeight="SemiBold" Foreground="#F4F3EF" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Name="StatusToastMessage" Text="点击上方「粘贴并解析」即可直接读取剪贴板完成解析并复制。" FontSize="12.5" Foreground="#A5A29B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Frameless Window Edge Resize Handles -->
                <Thumb Grid.RowSpan="4" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0" DragDelta="ResizeLeft_DragDelta" />
                <Thumb Grid.RowSpan="4" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" DragDelta="ResizeRight_DragDelta" />
                <Thumb Grid.RowSpan="4" Height="6" VerticalAlignment="Top" Cursor="SizeNS" Opacity="0" DragDelta="ResizeTop_DragDelta" />
                <Thumb Grid.RowSpan="4" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0" DragDelta="ResizeBottom_DragDelta" />
                <Thumb Grid.RowSpan="4" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0" DragDelta="ResizeBottomRight_DragDelta" />
            </Grid>
        </Border>
    </Grid>
</Window>
